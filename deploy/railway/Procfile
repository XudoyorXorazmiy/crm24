# Started by honcho from entrypoint.sh, cwd = /home/frappe/frappe-bench.
# nginx is the only process bound to Railway's public $PORT; the rest listen on
# loopback and are reached through it.
nginx: nginx -c /home/frappe/nginx.conf -g "daemon off;"
web: env/bin/gunicorn --bind 127.0.0.1:8000 --workers ${GUNICORN_WORKERS:-2} --timeout 120 --preload frappe.app:application
socketio: node apps/frappe/socketio.js
worker: bench worker --queue short,default,long
schedule: bench schedule
